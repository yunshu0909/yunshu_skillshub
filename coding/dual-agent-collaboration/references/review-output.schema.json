{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "reviewer",
    "verdict",
    "summary",
    "user_outcome_check",
    "contract_challenges",
    "findings",
    "verification",
    "limitations"
  ],
  "properties": {
    "phase": {
      "type": "string",
      "enum": ["intent", "plan", "implementation", "final"]
    },
    "reviewer": {
      "type": "string",
      "minLength": 3
    },
    "verdict": {
      "type": "string",
      "enum": ["ACK", "NOT_ACK", "BLOCKED"]
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "user_outcome_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stated_outcome", "actual_outcome", "aligned"],
      "properties": {
        "stated_outcome": { "type": "string", "minLength": 10 },
        "actual_outcome": { "type": "string", "minLength": 10 },
        "aligned": { "type": "boolean" }
      }
    },
    "contract_challenges": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "evidence", "required_action"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "note"]
          },
          "title": { "type": "string" },
          "evidence": { "type": "string", "minLength": 5 },
          "required_action": { "type": "string", "minLength": 5 }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts_inspected", "tests_assessed", "fresh_scan_completed"],
      "properties": {
        "artifacts_inspected": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tests_assessed": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fresh_scan_completed": { "type": "boolean" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
